{
  "render_policy_schema_version": "render-policy.schema.v3",
  "semantic_profile": "uml",
  "page": { "width": 900, "height": 520 },
  "margin": { "top": 32, "right": 32, "bottom": 32, "left": 32 },
  "style": {
    "background": { "fill": "#ffffff" },
    "font": { "family": "Inter, Arial, sans-serif", "size": 14 },
    "node": { "fill": "#ffffff", "stroke": "#000000", "stroke_width": 1.25, "rx": 0, "label_fill": "#000000" },
    "edge": { "stroke": "#000000", "stroke_width": 1.25, "label_fill": "#000000", "label_horizontal_position": "center", "label_horizontal_side": "auto", "label_vertical_position": "center", "label_vertical_side": "left" },
    "group": { "fill": "#ffffff", "stroke": "#000000", "stroke_width": 1, "rx": 0, "label_fill": "#000000", "label_size": 12 },
    "node_type_overrides": {
      "Package": { "fill": "#ffffff", "stroke": "#000000", "label_fill": "#000000", "decorator": "uml_package" },
      "Class": { "fill": "#ffffff", "stroke": "#000000", "label_fill": "#000000", "decorator": "uml_class" },
      "Enumeration": { "fill": "#ffffff", "stroke": "#000000", "label_fill": "#000000", "decorator": "uml_enumeration" }
    },
    "edge_type_overrides": {
      "Association": { "marker_start": "none", "marker_end": "none" },
      "Composition": { "marker_start": "filled_diamond", "marker_end": "none" },
      "Aggregation": { "marker_start": "hollow_diamond", "marker_end": "none" },
      "Dependency": { "line_style": "dashed", "marker_end": "open_arrow" }
    },
    "group_type_overrides": {
      "Package": { "fill": "#ffffff", "stroke": "#000000", "label_fill": "#000000", "decorator": "uml_package" }
    },
    "node_overrides": {},
    "edge_overrides": {},
    "group_overrides": {}
  }
}
